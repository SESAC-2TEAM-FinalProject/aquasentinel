# 사용법: terraform.tfvars로 복사 후 값 채우기
tfstate_bucket = "aquasentinel-tfstate-<ACCOUNT_ID>"

team_members = [
  { name = "team-a", iam_arn = "arn:aws:iam::<ACCOUNT_ID>:user/<실제IAM사용자>" },
  { name = "team-b", iam_arn = "arn:aws:iam::<ACCOUNT_ID>:user/<실제IAM사용자>" },
  { name = "team-c", iam_arn = "arn:aws:iam::<ACCOUNT_ID>:user/<실제IAM사용자>" },
]
